# ─────────────────────────────────────────────────────────────────────────────
# Maharat Model Madrasah — environment variables
# Copy to .env (local / Hostinger) or add them in the Vercel / Cloud Run dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# MySQL / MariaDB connection. Leave EMPTY to run in Demo Mode (in-memory data, nothing is saved).
# Hostinger example: mysql://u123456789_mmm:YOUR_DB_PASSWORD@localhost:3306/u123456789_mmm
DATABASE_URL=""

# Secret used to sign login sessions. REQUIRED when DATABASE_URL is set.
# Use at least 32 random characters, e.g. output of: openssl rand -base64 48
JWT_SECRET=""

# Google Gemini API key for Noor AI chat, AI publisher and document extractor (optional).
GEMINI_API_KEY=""
# Gemini model id (optional).
GEMINI_MODEL="gemini-4-hydrogen"

# Public URL of the website, used for canonical links, sitemap and certificate QR codes.
NEXT_PUBLIC_APP_URL="https://www.example.com"

# Optional: fixed key for the blog automation webhook (POST /api/blog/action-publish).
# If empty, the key set in Admin → Blog → Automation API is used.
BLOG_API_KEY=""

# First sign-in (needed once when DATABASE_URL is set): initial password of the "admin" account.
# At least 12 characters with letters and digits; known defaults such as admin123 are refused.
# No account has a password until this is set. You must choose a new password at first sign-in;
# afterwards this variable is no longer used and can be removed.
ADMIN_BOOTSTRAP_PASSWORD=""

# Optional: number of proxies in front of the app that add to X-Forwarded-For (default 1).
# Leave empty on Hostinger, Vercel and Cloud Run; use 2 when a CDN or load balancer sits in front.
TRUSTED_PROXY_HOPS=""

# Optional: ceiling in MB for photos and CVs uploaded by visitors and kept in the database
# (default 160). When it is reached new files are refused until old leads/applications are deleted.
MAX_STORED_UPLOAD_MB=""

# Optional, demos only: without DATABASE_URL a production server keeps the admin panel closed.
# DEMO_MODE=1 opens it with the public sample accounts. Never set this on the real site.
DEMO_MODE=""

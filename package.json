{
  "name": "maharat-model-madrasah-cms",
  "description": "Maharat Model Madrasah Academic Portal & Admin CMS",
  "private": true,
  "version": "2.2.0",
  "scripts": {
    "dev": "next dev",
    "build": "tsc --noEmit && node scripts/prepare-db.mjs && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "tsx --test src/utils/*.test.ts src/store/sync/*.test.ts src/server/*.test.ts src/server/**/*.test.ts",
    "test:e2e": "node scripts/e2e/run.cjs",
    "db:push": "prisma db push",
    "db:import": "tsx scripts/db-import.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@next/env": "16.4.6",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bcryptjs": "3.0.3",
    "jose": "6.2.18",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "16.4.6",
    "prisma": "7.10.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
